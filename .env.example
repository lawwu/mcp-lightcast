# Credentials: https://lightcast.io/our-data/api/access
LIGHTCAST_CREDENTIAL_MODE=environment
# Unreleased HTTP-only alternative: headers (no environment credential fallback).
# See docs/credentials.md before sharing a deployment.
LIGHTCAST_CLIENT_ID=your_client_id_here
LIGHTCAST_CLIENT_SECRET=your_client_secret_here

# Skills and Titles scope; free-tier accounts may need lightcast_open_free.
LIGHTCAST_OAUTH_SCOPE=emsi_open
# Optional per-family overrides (Classification may use lightcast_open):
# LIGHTCAST_API_SCOPES={"classification":"lightcast_open"}

# Optional service configuration
LIGHTCAST_BASE_URL=https://api.lightcast.io
LIGHTCAST_CLASSIFICATION_URL=https://classification.emsicloud.com
LIGHTCAST_CORE_LMI_URL=https://agnitio.emsicloud.com
LIGHTCAST_CORE_LMI_REQUESTS_PER_SECOND=1
LIGHTCAST_OAUTH_URL=https://auth.emsicloud.com/connect/token
LIGHTCAST_REQUESTS_PER_SECOND=5
LIGHTCAST_TIMEOUT=30
LIGHTCAST_MAX_RETRIES=2
MCP_SERVER_NAME=lightcast-mcp-server
MASK_ERROR_DETAILS=true
